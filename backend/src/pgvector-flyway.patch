+CREATE EXTENSION IF NOT EXISTS vector;
diff --git a/backend/src/main/resources/db/migration/V2__create_movies_table.sql b/backend/src/main/resources/db/migration/V2__create_movies_table.sql
new file mode 100644
index 0000000..5085449
--- /dev/null
+++ b/backend/src/main/resources/db/migration/V2__create_movies_table.sql
@@ -0,0 +1,12 @@
+-- Movies together with their Ollama embedding.
+-- vector(768) matches the output size of the nomic-embed-text model.
+-- If you switch to an embedding model with a different dimension, add a new
+-- migration that changes the column type and re-embeds the movies.
+CREATE TABLE movies (
+    id          BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+    title       VARCHAR(255) NOT NULL,
+    description TEXT         NOT NULL,
+    embedding   vector(768)  NOT NULL,
+    created_at  TIMESTAMPTZ  NOT NULL DEFAULT now(),
+    CONSTRAINT uq_movies_title UNIQUE (title)
+);
diff --git a/backend/src/main/resources/db/migration/V3__create_movies_embedding_index.sql b/backend/src/main/resources/db/migration/V3__create_movies_embedding_index.sql
