+        mockMvc = MockMvcBuilders.webAppContextSetup(context).build();
+    }
+
+    private Long idOf(String title) {
+        return movieRepository.findAll().stream()
+                .filter(movie -> movie.getTitle().equals(title))
+                .findFirst()
+                .orElseThrow()
+                .getId();
+    }
+
+    @Test
+    void startupSavesMoviesWithEmbeddingsInTheDatabase() {
+        assertTrue(movieRepository.count() > 0);
+        assertTrue(movieRepository.existsByTitle("Inception"));
+        assertTrue(movieRepository.findByEmbeddingDataIsNull().isEmpty());
+    }
+
+    @Test
+    void embeddingSurvivesDatabaseRoundTrip() {
+        float[] vector = {0.25f, -2.5f, 3f};
+        Movie saved = movieRepository.save(new Movie("Round Trip Movie", "Only used by this test"));
+        try {
+            saved.setEmbedding(vector);
+            movieRepository.save(saved);
+
+            Movie loaded = movieRepository.findById(saved.getId()).orElseThrow();
+            assertArrayEquals(vector, loaded.getEmbedding());
+        } finally {
+            movieRepository.deleteById(saved.getId());
+        }
+    }
+
+    @Test
+    void catalogueListsAllMoviesWithoutEmbeddings() throws Exception {
+        mockMvc.perform(get("/api/movies"))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.length()").value((int) movieRepository.count()))
+                .andExpect(jsonPath("$[0].id").exists())
+                .andExpect(jsonPath("$[0].title").exists())
+                .andExpect(jsonPath("$[0].description").exists())
+                .andExpect(jsonPath("$[0].embedding").doesNotExist());
+    }
+
+    @Test
+    void getMovieByIdAndUnknownId() throws Exception {
+        mockMvc.perform(get("/api/movies/{id}", idOf("Inception")))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.title").value("Inception"));
+
+        mockMvc.perform(get("/api/movies/{id}", 999_999))
+                .andExpect(status().isNotFound());
+    }
+
+    @Test
+    void searchReturnsClosestMovieFirst() throws Exception {
+        mockMvc.perform(get("/api/movies/search")
+                        .param("query", "dinosaurs theme park")
+                        .param("limit", "3"))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.length()").value(3))
+                .andExpect(jsonPath("$[0].title").value("Jurassic Park"))
+                .andExpect(jsonPath("$[0].similarity").isNumber());
+
+        List<MovieMatch> matches = movieService.search("dinosaurs theme park", 5);
+        for (int i = 1; i < matches.size(); i++) {
+            assertTrue(matches.get(i - 1).similarity() >= matches.get(i).similarity(),
+                    "results must be sorted from most to least similar");
+        }
+    }
+
+    @Test
+    void blankSearchQueryIsABadRequest() throws Exception {
+        mockMvc.perform(get("/api/movies/search").param("query", "   "))
+                .andExpect(status().isBadRequest());
+    }
+
+    @Test
+    void recommendationsAreThreeOtherMovies() throws Exception {
+        Long id = idOf("Interstellar");
+
+        mockMvc.perform(get("/api/movies/{id}/recommendations", id))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.length()").value(3));
+
+        List<MovieMatch> recommendations = movieService.recommend(id, 3);
+        assertEquals(3, recommendations.size());
+        assertFalse(recommendations.stream().anyMatch(match -> match.id().equals(id)),
+                "a movie must not be recommended to itself");
+
+        mockMvc.perform(get("/api/movies/{id}/recommendations", 999_999))
+                .andExpect(status().isNotFound());
+    }
+
+    @Test
+    void existingEmbeddingsEndpointStillWorks() throws Exception {
+        mockMvc.perform(post("/api/embeddings")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content("{\"text\": \"dinosaurs theme park\"}"))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.length()").value(3))
+                .andExpect(jsonPath("$[0].title").value("Jurassic Park"));
+
+        mockMvc.perform(post("/api/embeddings")
+                        .contentType(MediaType.APPLICATION_JSON)
+                        .content("{\"text\": \"\"}"))
+                .andExpect(status().isBadRequest());
+    }
+
+    @Test
+    void corsHeaderIsSentForBrowserRequests() throws Exception {
+        mockMvc.perform(get("/api/movies").header("Origin", "http://localhost:5500"))
+                .andExpect(status().isOk())
+                .andExpect(header().exists("Access-Control-Allow-Origin"));
+    }
+}
