+@SpringBootTest
+class MovieApiIntegrationTest {
+
+    /** Replaces the Ollama call with a simple word-hashing embedding. */
+    @TestConfiguration
+    static class StubEmbeddingConfig {
+        @Bean
+        @Primary
+        OllamaEmbeddingService stubEmbeddingService() {
+            return new OllamaEmbeddingService("http://localhost:1", "stub") {
+                @Override
+                public float[] generateEmbedding(String text) {
+                    return embed(text);
+                }
+            };
+        }
+    }
+
+    private static float[] embed(String text) {
+        float[] vector = new float[128];
+        for (String word : text.toLowerCase().split("[^a-z]+")) {
+            if (word.length() > 3) {
+                vector[Math.floorMod(word.hashCode(), 128)] += 1f;
+            }
+        }
+        return vector;
+    }
+
+    @Autowired
