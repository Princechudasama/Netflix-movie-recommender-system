@@ -0,0 +1,78 @@
+package com.prince.backend.service;
+
+import com.prince.backend.Model.Movie;
+import com.prince.backend.exception.EmbeddingUnavailableException;
+import com.prince.backend.repository.MovieRepository;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.boot.ApplicationArguments;
+import org.springframework.boot.ApplicationRunner;
+import org.springframework.core.io.ClassPathResource;
+import org.springframework.stereotype.Component;
+import tools.jackson.core.type.TypeReference;
+import tools.jackson.databind.json.JsonMapper;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.List;
+
+/**
+ * On startup: saves the movies from Movies.json into the database (if not already there)
+ * and generates their embeddings through Ollama.
+ * <p>
+ * If Ollama is not running the application still starts: the catalogue works,
+ * and the missing embeddings are generated on the first search.
+ */
+@Component
+public class MovieDataLoader implements ApplicationRunner {
+
+    private static final Logger log = LoggerFactory.getLogger(MovieDataLoader.class);
+
+    /** One entry of Movies.json. */
+    record SeedMovie(String title, String description) {
+    }
+
+    private final MovieRepository movieRepository;
+    private final MovieService movieService;
+    private final JsonMapper jsonMapper;
+
+    public MovieDataLoader(MovieRepository movieRepository,
+                           MovieService movieService,
+                           JsonMapper jsonMapper) {
+        this.movieRepository = movieRepository;
+        this.movieService = movieService;
+        this.jsonMapper = jsonMapper;
+    }
+
+    @Override
+    public void run(ApplicationArguments args) throws IOException {
+        int saved = seedMovies();
+        log.info("Saved {} new movies from Movies.json ({} in database).", saved, movieRepository.count());
+
+        try {
+            int embedded = movieService.embedMissingMovies();
+            log.info("Generated embeddings for {} movies.", embedded);
+        } catch (EmbeddingUnavailableException e) {
+            log.warn("Ollama is not available, embeddings were not generated at startup. "
+                    + "Start Ollama; missing embeddings are created on the first search. ({})", e.getMessage());
+        }
+    }
+
+    private int seedMovies() throws IOException {
+        ClassPathResource resource = new ClassPathResource("Movies.json");
+
+        List<SeedMovie> seeds;
+        try (InputStream inputStream = resource.getInputStream()) {
+            seeds = jsonMapper.readValue(inputStream, new TypeReference<List<SeedMovie>>() {
+            });
+        }
+
+        List<Movie> newMovies = seeds.stream()
+                .filter(seed -> !movieRepository.existsByTitle(seed.title()))
+                .map(seed -> new Movie(seed.title(), seed.description()))
+                .toList();
+
+        movieRepository.saveAll(newMovies);
+        return newMovies.size();
+    }
+}
diff --git a/backend/src/main/java/com/prince/backend/service/MovieService.java b/backend/src/main/java/com/prince/backend/service/MovieService.java
new file mode 100644
index 0000000..769fff7
