@@ -0,0 +1,31 @@
+package com.prince.backend.Model;
+
+import java.nio.ByteBuffer;
+
+/**
+ * Converts an embedding vector to and from compact binary (4 bytes per float)
+ * so it can be stored in a plain byte[] column on both H2 and PostgreSQL (bytea).
+ */
+public final class EmbeddingCodec {
+
+    private EmbeddingCodec() {
+    }
+
+    public static byte[] encode(float[] vector) {
+        if (vector == null) {
+            return null;
+        }
+        ByteBuffer buffer = ByteBuffer.allocate(vector.length * Float.BYTES);
+        buffer.asFloatBuffer().put(vector);
+        return buffer.array();
+    }
+
+    public static float[] decode(byte[] data) {
+        if (data == null) {
+            return null;
+        }
+        float[] vector = new float[data.length / Float.BYTES];
+        ByteBuffer.wrap(data).asFloatBuffer().get(vector);
+        return vector;
+    }
+}
