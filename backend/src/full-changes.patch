+package com.prince.backend.controller;
+
+import com.prince.backend.Model.MovieDto;
+import com.prince.backend.Model.MovieMatch;
+import com.prince.backend.service.MovieService;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+import java.util.List;
+
+@RestController
+@RequestMapping("/api/movies")
+public class MovieController {
+
+    private final MovieService movieService;
+
+    public MovieController(MovieService movieService) {
+        this.movieService = movieService;
+    }
+
+    /** GET /api/movies - the whole catalogue. */
+    @GetMapping
+    public List<MovieDto> getAllMovies() {
+        return movieService.getAllMovies();
+    }
+
+    /** GET /api/movies/{id} - one movie. */
+    @GetMapping("/{id}")
+    public MovieDto getMovie(@PathVariable Long id) {
+        return movieService.getMovie(id);
+    }
+
+    /** GET /api/movies/search?query=...&limit=12 - semantic search. */
+    @GetMapping("/search")
+    public List<MovieMatch> search(
+            @RequestParam("query") String query,
+            @RequestParam(value = "limit", defaultValue = "12") int limit) {
+        return movieService.search(query, limit);
+    }
+
+    /** GET /api/movies/{id}/recommendations?limit=3 - similar movies. */
+    @GetMapping("/{id}/recommendations")
+    public List<MovieMatch> getRecommendations(
+            @PathVariable Long id,
+            @RequestParam(value = "limit", defaultValue = "3") int limit) {
+        return movieService.recommend(id, limit);
+    }
+}
