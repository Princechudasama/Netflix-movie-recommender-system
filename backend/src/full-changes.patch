+++ b/backend/src/main/java/com/prince/backend/service/MovieService.java
@@ -0,0 +1,110 @@
+package com.prince.backend.service;
+
+import com.prince.backend.Model.Movie;
+import com.prince.backend.Model.MovieDto;
+import com.prince.backend.Model.MovieMatch;
+import com.prince.backend.exception.MovieNotFoundException;
+import com.prince.backend.repository.MovieRepository;
+import org.springframework.stereotype.Service;
+
+import java.util.Comparator;
+import java.util.List;
+import java.util.Objects;
+
+/**
+ * Catalogue, semantic search and recommendations on top of the JPA repository.
+ */
+@Service
+public class MovieService {
+
+    private static final int MAX_LIMIT = 50;
+
+    private final MovieRepository movieRepository;
+    private final OllamaEmbeddingService embeddingService;
+
+    public MovieService(MovieRepository movieRepository,
+                        OllamaEmbeddingService embeddingService) {
+        this.movieRepository = movieRepository;
+        this.embeddingService = embeddingService;
+    }
+
+    /** All movies for the catalogue, sorted by title. */
+    public List<MovieDto> getAllMovies() {
+        return movieRepository.findAllSummaries();
+    }
+
+    public MovieDto getMovie(Long id) {
+        Movie movie = movieRepository.findById(id)
+                .orElseThrow(() -> new MovieNotFoundException(id));
+        return new MovieDto(movie.getId(), movie.getTitle(), movie.getDescription());
+    }
+
+    /**
+     * Semantic search: embeds the query and returns the closest movies by cosine similarity.
+     */
+    public List<MovieMatch> search(String query, int limit) {
+        if (query == null || query.isBlank()) {
+            throw new IllegalArgumentException("Query must not be empty");
+        }
+
+        float[] queryEmbedding = embeddingService.generateEmbedding(query.trim());
+
+        // Ollama was down at startup? It is reachable now, so catch up on missing vectors.
+        embedMissingMovies();
+
+        return rank(queryEmbedding, movieRepository.findAll(), null, limit);
+    }
+
+    /**
+     * Movies most similar to the given movie (the movie itself is excluded).
+     */
+    public List<MovieMatch> recommend(Long movieId, int limit) {
+        Movie movie = movieRepository.findById(movieId)
+                .orElseThrow(() -> new MovieNotFoundException(movieId));
+
+        float[] base = movie.getEmbedding();
+        if (base == null) {
+            base = embeddingService.generateEmbedding(movie.getDescription());
+            movie.setEmbedding(base);
+            movieRepository.save(movie);
+        }
+
+        return rank(base, movieRepository.findAll(), movieId, limit);
+    }
+
+    /**
+     * Generates and saves embeddings for every movie that does not have one yet.
+     *
+     * @return how many movies were embedded
+     */
+    public int embedMissingMovies() {
+        int embedded = 0;
+        for (Movie movie : movieRepository.findByEmbeddingDataIsNull()) {
+            movie.setEmbedding(embeddingService.generateEmbedding(movie.getDescription()));
+            movieRepository.save(movie);
+            embedded++;
+        }
+        return embedded;
+    }
+
+    private List<MovieMatch> rank(float[] target, List<Movie> candidates, Long excludeId, int limit) {
+        int safeLimit = Math.min(Math.max(limit, 1), MAX_LIMIT);
+
+        return candidates.stream()
+                .filter(movie -> !Objects.equals(movie.getId(), excludeId))
+                .map(movie -> new Candidate(movie, movie.getEmbedding()))
+                .filter(c -> c.vector() != null && c.vector().length == target.length)
+                .map(c -> new MovieMatch(
+                        c.movie().getId(),
+                        c.movie().getTitle(),
+                        c.movie().getDescription(),
+                        VectorMath.cosineSimilarity(target, c.vector())))
+                .sorted(Comparator.comparingDouble(MovieMatch::similarity).reversed())
+                .limit(safeLimit)
+                .toList();
+    }
+
+    /** A movie with its decoded embedding (decoded once per request). */
+    private record Candidate(Movie movie, float[] vector) {
+    }
+}
